# Database
POSTGRES_DB=parcelview
POSTGRES_USER=parcelview
POSTGRES_PASSWORD=changeme

# Spring Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/parcelview
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# App
SERVER_PORT=2320
SPRING_PROFILES_ACTIVE=prod # dev if working locally

# Docker image to build: "Dockerfile" (credentials via env vars) or "Dockerfile.bws" (Bitwarden Secrets Manager)
APP_DOCKERFILE=Dockerfile

# Bitwarden Secrets Manager (courier API credentials are pulled from here at container start,
# not stored as plaintext env vars — see docker-entrypoint.sh)
BWS_ACCESS_TOKEN=
BWS_PROJECT_ID=